{
  "version": 2,
  "buildCommand": "yarn build",
  "outputDirectory": "public",
  "framework": null,
  "installCommand": "yarn install",
  "functions": {
    "api/index.php": {
      "runtime": "@vercel/php@2.0.0"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/(.*\\.(js|css|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot|json|xml|txt))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}

