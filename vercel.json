{
  "version": 2,
  "buildCommand": "yarn build",
  "outputDirectory": "public",
  "framework": null,
  "installCommand": "yarn install",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "includeFiles": [
        "vendor/**",
        "bootstrap/**",
        "app/**",
        "config/**",
        "database/**",
        "resources/**",
        "routes/**",
        "storage/**",
        "src/**",
        "ieducar/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/(.*\\.(js|css|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot|json|xml|txt))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}

